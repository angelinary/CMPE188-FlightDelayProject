# On Windows (with Google Drive for Desktop):
# FLIGHT_DELAY_DATA=C:\My Drive\sem-8\CMPE188\flight-delay-proj-data
#
# Shared Drive folder: https://drive.google.com/drive/folders/1VNTXNzXciRJRgqFlq38CLtXsxcS5vvrP

FLIGHT_DELAY_DATA=/path/to/your/GoogleDrive/.../flight-delay-proj-data
